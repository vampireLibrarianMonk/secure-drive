<Project>

  <!-- Shared build settings for every project in the repository (spec section 27). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Product metadata embedded in assemblies and propagated into the SBOM. -->
    <!-- Keep in sync with the VERSION file and CHANGELOG.md top entry. -->
    <Version>0.2.0</Version>
    <Product>Emergency Archive</Product>
    <Authors>Emergency Archive Project</Authors>
    <Company>Emergency Archive Project</Company>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
