<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EmergencyArchive.UI"
        xmlns:core="clr-namespace:EmergencyArchive.Core;assembly=EmergencyArchive.Core"
        x:Class="EmergencyArchive.UI.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="EMERGENCY ARCHIVE"
        Width="1080" Height="720"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
    <!-- First-run: create a new archive (owner setup, no CLI needed) -->
    <Grid x:Name="CreateScreen" IsVisible="{Binding IsCreating}">
        <Border Classes="card"
                Width="560"
                Padding="44,40"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="CREATE YOUR ARCHIVE"
                           FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="This drive has no archive yet. Choose a password to create one."
                           FontSize="13" Opacity="0.75"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,2,0,20" />

                <TextBlock Text="New password" FontSize="13" Opacity="0.8" />
                <TextBox PasswordChar="&#x2022;"
                         Text="{Binding NewArchivePassword}"
                         Watermark="At least 12 characters — a passphrase works well"
                         FontSize="15" Height="38" />

                <TextBlock Text="Repeat password" FontSize="13" Opacity="0.8" Margin="0,8,0,0" />
                <TextBox PasswordChar="&#x2022;"
                         Text="{Binding ConfirmArchivePassword}"
                         Watermark="Type the same password again"
                         FontSize="15" Height="38">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CreateArchiveCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Content="CREATE ARCHIVE"
                        Classes="primary"
                        Command="{Binding CreateArchiveCommand}"
                        Height="44" FontSize="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,16,0,0" />

                <TextBlock Text="There is no password reset. Store it safely and never keep it with the drive."
                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,10,0,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Opacity="0.85"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Password screen (spec section 7) -->
    <Grid x:Name="PasswordScreen" IsVisible="{Binding IsUnlockable}">
        <Border Classes="card"
                Width="540"
                Padding="44,40"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="EMERGENCY ARCHIVE"
                           FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Read-only access to your saved documents"
                           FontSize="13" Opacity="0.75"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,22" />

                <TextBlock Text="Password" FontSize="13" Opacity="0.8" />
                <TextBox x:Name="PasswordBox"
                         PasswordChar="&#x2022;"
                         Text="{Binding Password}"
                         Watermark="Enter the archive password"
                         FontSize="16" Height="40">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Content="UNLOCK"
                        Classes="primary"
                        Command="{Binding UnlockCommand}"
                        Height="44" FontSize="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,16,0,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Opacity="0.85"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="If you found this USB drive: start with the instructions in RECOVERY-INSTRUCTIONS.txt at the top of the drive."
                   FontSize="11" Opacity="0.55"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="24,0,24,14" MaxWidth="760" />
    </Grid>

    <!-- Archive screen (read-only, spec sections 7/11/22).
         Centered with a max content width so the layout stays balanced on
         wide monitors instead of stretching the document list edge to edge. -->
    <Grid x:Name="BrowseScreen" IsVisible="{Binding IsBrowsing}" Margin="16,12">
        <Grid MaxWidth="1180" HorizontalAlignment="Stretch"
              RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="EMERGENCY ARCHIVE" Classes="screenTitle" />
                <Border CornerRadius="4" Padding="8,3"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="READ ONLY" FontSize="11" FontWeight="SemiBold" Opacity="0.85" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="SETUP" Command="{Binding EnterSetupCommand}" Padding="16,6" />
                <Button Content="LOCK" Command="{Binding LockCommand}" Padding="24,6" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Search: as-you-type filters by name; Enter searches inside documents -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBox Watermark="Type to filter by name — press Enter to search inside the documents"
                     Text="{Binding SearchText}" FontSize="14" Height="36">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Content="SEARCH" Command="{Binding SearchCommand}"
                    Margin="8,0,0,0" Padding="20,6" />
        </Grid>

        <!-- Folder sidebar + document list -->
        <Grid Grid.Row="2" ColumnDefinitions="248,*" Margin="0,14,0,0">
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FOLDERS" Classes="sectionHeading" Margin="6,0,0,8" />
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryItemViewModel">
                                <TextBlock Text="{Binding DisplayName}" Margin="2,1"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="{Binding ResultsSummary}" FontSize="11" Opacity="0.65"
                           Margin="6,0,0,8" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredDocuments}"
                         SelectedItem="{Binding SelectedDocument}"
                         DoubleTapped="OnDocumentDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentItemViewModel">
                            <StackPanel Margin="2,3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Folder}" FontSize="11"
                                               Opacity="0.55" Margin="12,2,0,0"
                                               MaxWidth="340" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="{Binding Snippet}" IsVisible="{Binding HasSnippet}"
                                           TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Action bar -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <TextBlock Text="{Binding SelectedDocument.Name}"
                       IsVisible="{Binding HasSelectedDocument}"
                       VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" Margin="6,0,14,0" />
            <Button Grid.Column="1" Content="OPEN" Click="OnOpenClicked"
                    IsEnabled="{Binding HasSelectedDocument}" Padding="26,8" FontWeight="SemiBold" />
            <Button Grid.Column="2" Content="EXPORT / COPY" Click="OnExportClicked"
                    IsEnabled="{Binding HasSelectedDocument}" Padding="26,8" Margin="10,0,0,0" />
        </Grid>

        <!-- Status line + index chip -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{Binding IndexStatusText}" FontSize="11" Opacity="0.6"
                       VerticalAlignment="Bottom" Margin="14,0,0,0"
                       MaxWidth="430" TextTrimming="CharacterEllipsis" />
        </Grid>
        </Grid>
    </Grid>

    <!-- Setup Mode (spec sections 12/13/16; owner only, reached after unlock).
         A DockPanel keeps a fixed header on top and the activity log docked at
         the bottom with its own scroll, while the numbered task cards scroll in
         the middle. Separating the two scroll regions prevents the log from
         being clipped and stops nested scroll wheels from fighting. -->
    <Panel x:Name="SetupScreen"
           IsVisible="{Binding IsSetupMode}"
           Margin="0">

      <!-- Inner DockPanel binds against the Setup view model; the OUTER
           Panel's IsVisible stays bound to the MainWindowViewModel
           (IsSetupMode) so the whole screen shows/hides correctly. The whole
           Setup panel (header + cards + activity log) hides while the credential
           viewer is open so the log cannot overlap or block it. -->
      <Panel x:Name="SetupContent" IsVisible="{Binding !IsCredentialsMode}">
      <DockPanel DataContext="{Binding Setup}" x:DataType="vm:SetupViewModel">

        <!-- Fixed header -->
        <Border DockPanel.Dock="Top" Padding="20,14,20,12"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" MaxWidth="980" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="ARCHIVE SETUP" Classes="screenTitle" />
                    <TextBlock Text="Owner only" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="DONE" Click="OnSetupDoneClicked"
                        Padding="24,8" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Activity log: docked at the bottom as a fixed-height, independently
             scrollable strip (its own ScrollViewer). Being a DockPanel sibling
             of the cards ScrollViewer — not nested inside it — means it never
             gets clipped by the window edge and does not steal the page scroll.
             The cards fill the space above and scroll on their own. -->
        <Border DockPanel.Dock="Bottom" Padding="20,10,20,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="8" MaxWidth="980" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="ACTIVITY LOG" Classes="sectionHeading" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ActivityCountDisplay}"
                               FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Nothing recorded yet. Actions like UPDATE, VERIFY, and password changes appear here."
                           IsVisible="{Binding !HasActivity}"
                           TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
                <ScrollViewer IsVisible="{Binding HasActivity}"
                              Height="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ActivityEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:OperationLogEntry">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                            CornerRadius="4" Padding="7,2" Height="20"
                                            VerticalAlignment="Top" Margin="0,1,10,0">
                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                   FontWeight="SemiBold" Opacity="0.85"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{Binding TimestampUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm} UTC'}"
                                                   FontSize="11" Opacity="0.55" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Scrollable task cards, in a numbered top-to-bottom flow (fill the
             space above the docked activity log). The whole SetupContent panel
             hides when the credential viewer is open. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,14,20,0">
          <!-- Bottom margin on the content guarantees the scroll extent reaches
               past the last card (Password Manager), so it can scroll fully
               into view above the docked activity log. -->
          <StackPanel Spacing="14" Margin="0,0,0,48" MaxWidth="980" HorizontalAlignment="Stretch">

            <!-- 1. Status at a glance -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="ARCHIVE STATUS" Classes="sectionHeading" />
                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Documents" Classes="fieldLabel" />
                            <TextBlock Text="{Binding DocumentCountDisplay}" Classes="fieldValue" />
                            <TextBlock Text="Archive size" Classes="fieldLabel" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ArchiveSizeDisplay}" Classes="fieldValue" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Free drive space" Classes="fieldLabel" />
                            <TextBlock Text="{Binding DriveFreeDisplay}" Classes="fieldValue" />
                            <TextBlock Text="Revision" Classes="fieldLabel" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding RevisionDisplay}" Classes="fieldValue" />
                            <TextBlock Text="Last update" Classes="fieldLabel" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding LastUpdateDisplay}" Classes="fieldValue" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Archive id" Classes="fieldLabel" />
                            <TextBlock Text="{Binding ArchiveId}" Classes="fieldValue" TextWrapping="Wrap" />
                            <TextBlock Text="Archive version" Classes="fieldLabel" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ArchiveVersion}" Classes="fieldValue" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding IntegrityStatus}" TextWrapping="Wrap"
                               FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- 1. Estate planning (the reason the archive exists): an editable,
                 scrollable letter that loads any existing letter for further edits. -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="1 · ESTATE PLANNING" Classes="sectionHeading" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding EstateStatusChip}"
                                   FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="13"
                               Text="Start here. This is a plain-language letter for whoever inherits this archive — how to search, where things are filed, and who to contact. Edit it directly below and click SAVE LETTER. A password-free copy is also placed on the drive so a finder knows what it is." />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <TextBlock Text="Your name" Classes="fieldLabel" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding EstateOwnerName}"
                                 Watermark="e.g. Jane Doe (used when inserting a fresh template)" />
                        <TextBlock Grid.Row="1" Text="Contact for help" Classes="fieldLabel" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EstateContact}"
                                 Watermark="Optional: lawyer / executor name and phone or email" />
                    </Grid>

                    <TextBlock Text="Letter to my family (editable)" Classes="fieldLabel" />
                    <TextBox Text="{Binding EstateLetterText}"
                             AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                             Height="240"
                             VerticalContentAlignment="Top"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="SAVE LETTER" Command="{Binding SaveEstateLetterCommand}"
                                Classes="primary" HorizontalAlignment="Left" />
                        <Button Content="INSERT FRESH TEMPLATE" Command="{Binding GenerateTemplateCommand}"
                                Padding="14,6" />
                    </StackPanel>
                    <TextBlock Text="{Binding EstateStatus}" TextWrapping="Wrap" Opacity="0.9"
                               IsVisible="{Binding HasEstateStatus}" />
                </StackPanel>
            </Border>

            <!-- 2. Your documents: add individual files, or import whole folders -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="2 · YOUR DOCUMENTS" Classes="sectionHeading" />

                    <!-- 2a. Add individual files -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Add individual files" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="12"
                                   Text="Pick one or more files and add them straight to a category. They are indexed and searchable right away." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Category" Classes="fieldLabel" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding ImportCategories}"
                                      SelectedItem="{Binding SelectedImportCategory}"
                                      MinWidth="150" />
                            <Button Content="ADD FILE(S)…" Click="OnAddFilesClicked" Padding="14,6" />
                        </StackPanel>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,1,0,0" />

                    <!-- 2b. Import from folders (sources) -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Import from folders" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8" FontSize="12"
                                   Text="Choose folders on this computer that hold your documents, then import. Re-run IMPORT whenever those folders change." />
                        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MaxHeight="130">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SourceItemViewModel">
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="ADD FOLDER…" Click="OnAddSourceClicked" Padding="14,6" />
                            <Button Content="REMOVE SELECTED" Command="{Binding RemoveSourceCommand}" Padding="14,6" />
                            <TextBlock Text="{Binding SourceCount, StringFormat='{}{0} folder(s) configured'}"
                                       VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                        <Button Content="IMPORT / UPDATE ARCHIVE" Command="{Binding UpdateCommand}"
                                Classes="primary" HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Text="{Binding SetupStatus}" TextWrapping="Wrap" Opacity="0.9"
                               IsVisible="{Binding SetupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- 3. Manage documents: review and delete -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="3 · MANAGE DOCUMENTS" Classes="sectionHeading" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ManageDocumentsCountDisplay}"
                                   FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="13"
                               Text="Review what is in the archive; select a document to rename it, move it to another category, replace its contents, or delete it. Deleting is permanent — there is no undo inside the archive." />
                    <ListBox ItemsSource="{Binding ManageableDocuments}"
                             SelectedItem="{Binding SelectedDocumentPath}" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="2,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Edit the selected document (rename / move / replace) -->
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12"
                            IsVisible="{Binding SelectedDocumentPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="EDIT SELECTED" Classes="sectionHeading" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Text="Rename" Classes="fieldLabel" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding RenameText}" Watermark="New file name (with extension)" />
                                <Button Grid.Column="2" Content="RENAME" Command="{Binding RenameDocumentCommand}" Padding="14,6" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Text="Move to" Classes="fieldLabel" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ImportCategories}"
                                          SelectedItem="{Binding MoveTargetCategory}" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" Content="MOVE" Command="{Binding MoveDocumentCommand}" Padding="14,6" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="REPLACE FILE…" Click="OnReplaceDocumentClicked"
                                        IsEnabled="{Binding CanReplaceDocument}" Padding="14,6" />
                                <Button Content="{Binding DeleteButtonText}" Command="{Binding DeleteDocumentCommand}"
                                        Padding="14,6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Maintenance -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="4 · MAINTENANCE" Classes="sectionHeading" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="13"
                               Text="Check the archive is healthy and rebuild the search index if search behaves oddly." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="VERIFY ARCHIVE" Command="{Binding VerifyCommand}" Padding="16,6" />
                        <Button Content="REBUILD SEARCH INDEX" Command="{Binding RebuildIndexCommand}" Padding="16,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. Security -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="5 · SECURITY" Classes="sectionHeading" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="13"
                               Text="Change the archive password, or export the recovery instructions that explain how to open the archive without this app." />
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <TextBox PasswordChar="&#x2022;" Text="{Binding NewPassword}" Watermark="New password" />
                        <TextBox Grid.Column="1" PasswordChar="&#x2022;" Text="{Binding ConfirmNewPassword}" Watermark="Repeat new password" />
                        <Button Grid.Column="2" Content="CHANGE PASSWORD" Command="{Binding ChangePasswordCommand}" Padding="14,6" />
                    </Grid>
                    <Button Content="EXPORT RECOVERY INSTRUCTIONS" Command="{Binding ExportRecoveryInstructionsCommand}"
                            Padding="14,6" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 6. Password manager: opens the in-app credential viewer (native,
                 nothing installed, nothing written to disk). Command lives on the
                 root MainWindowViewModel, reached via ElementName. -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="6 · PASSWORD MANAGER" Classes="sectionHeading" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="13"
                               Text="Store and look up website logins inside the vault. Values stay hidden until you reveal them, and nothing is written to disk in the clear." />
                    <Button Content="OPEN PASSWORD MANAGER"
                            Command="{Binding $parent[Window].DataContext.OpenCredentialsCommand}"
                            x:CompileBindings="False"
                            Classes="primary" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </DockPanel>
      </Panel>

      <!-- Credential viewer sub-screen: native Avalonia, overlays the Setup
           cards when open. DataContext is the root VM's Credentials. -->
      <DockPanel x:Name="CredentialsScreen"
                 IsVisible="{Binding IsCredentialsMode}"
                 Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <!-- Inner content binds against the CredentialViewModel; the OUTER
             DockPanel keeps the root DataContext so IsVisible (IsCredentialsMode)
             resolves correctly, mirroring the Setup screen structure. -->
        <DockPanel x:Name="CredentialsRoot" DataContext="{Binding Credentials}"
                   x:DataType="vm:CredentialViewModel">

        <!-- Header with search + close -->
        <Border DockPanel.Dock="Top" Padding="20,14,20,12"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
          <StackPanel Spacing="10" MaxWidth="980" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="PASSWORD MANAGER" Classes="screenTitle" />
                <TextBlock Text="Values hidden by default" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="ADD" Command="{Binding AddCommand}"
                        Classes="primary" Padding="20,8" FontWeight="SemiBold"
                        IsVisible="{Binding !IsEditing}" />
                <Button Content="IMPORT" Click="OnImportKdbxClicked"
                        Padding="16,8" FontWeight="SemiBold"
                        IsVisible="{Binding !IsEditing}" />
                <Button Content="EXPORT" Click="OnExportKdbxClicked"
                        Padding="16,8" FontWeight="SemiBold"
                        IsVisible="{Binding !IsEditing}" />
                <Button Content="CLOSE"
                        Command="{Binding $parent[Window].DataContext.CloseCredentialsCommand}"
                        Padding="24,8" FontWeight="SemiBold"
                        x:CompileBindings="False" />
              </StackPanel>
            </Grid>
            <TextBox Text="{Binding SearchText}" IsVisible="{Binding !IsEditing}"
                     Watermark="Search by website or username…" />
            <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.7"
                       IsVisible="{Binding !IsEditing}" />

            <!-- KeePass (.kdbx) password prompt for import/export. The file is
                 chosen first (code-behind), then this asks for its password. -->
            <Border IsVisible="{Binding IsKdbxPrompt}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding KdbxPromptTitle}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                           Text="Enter the password for the KeePass file (this is separate from your archive password)." />
                <TextBox Text="{Binding KdbxPassword}" PasswordChar="&#x25CF;"
                         Watermark="KeePass file password" />
                <TextBlock Text="{Binding KdbxError}" Foreground="#D9534F"
                           TextWrapping="Wrap" IsVisible="{Binding HasKdbxError}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="CONTINUE" Command="{Binding ConfirmKdbxCommand}"
                          Classes="primary" Padding="20,6" FontWeight="SemiBold" />
                  <Button Content="CANCEL" Command="{Binding CancelKdbxCommand}" Padding="20,6" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Empty state (hidden while the editor is open) -->
        <TextBlock DockPanel.Dock="Top" Margin="20,16"
                   IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Opacity="0.75"
                   Text="No credentials are stored yet. Click ADD to create one. Importing a KeePass (.kdbx) file is coming soon." />

        <!-- Credential cards -->
        <ScrollViewer x:Name="CredentialsList"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding !IsEditing}"
                      Padding="20,14,20,20">
          <ItemsControl ItemsSource="{Binding Items}" MaxWidth="980" HorizontalAlignment="Stretch">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CredentialItemViewModel">
                <Border Classes="card" Margin="0,0,0,14">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding Site}" FontWeight="SemiBold" FontSize="15"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Edit" Padding="12,4"
                              Command="{Binding $parent[Window].DataContext.Credentials.EditCommand}"
                              CommandParameter="{Binding}" x:CompileBindings="False" />
                      <Button Grid.Column="2" Content="Delete" Padding="12,4"
                              Command="{Binding $parent[Window].DataContext.Credentials.DeleteCommand}"
                              CommandParameter="{Binding}" x:CompileBindings="False" />
                    </Grid>

                    <!-- Username -->
                    <Grid ColumnDefinitions="110,*,Auto">
                      <TextBlock Text="Username" Classes="fieldLabel" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Username}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="2" Content="Copy" Padding="10,4"
                              Click="OnCopyUsernameClicked" Tag="{Binding Username}" />
                    </Grid>

                    <!-- Password (obfuscated) -->
                    <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="6">
                      <TextBlock Text="Password" Classes="fieldLabel" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Password.Display}"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <ToggleButton Grid.Column="2" Padding="10,4"
                                    Content="{Binding Password.RevealButtonText}"
                                    IsChecked="{Binding Password.IsRevealed}" />
                      <Button Grid.Column="3" Content="Copy" Padding="10,4"
                              Click="OnCopySecretClicked" Tag="{Binding Password}" />
                    </Grid>

                    <!-- Extras toggle -->
                    <ToggleButton IsChecked="{Binding IsExtrasExpanded}"
                                  IsVisible="{Binding HasExtras}"
                                  HorizontalAlignment="Left" Padding="10,4"
                                  Content="{Binding ExtrasCount, StringFormat='More fields ({0})'}" />

                    <!-- Extras (each obfuscated with reveal + copy) -->
                    <ItemsControl ItemsSource="{Binding Extras}"
                                  IsVisible="{Binding IsExtrasExpanded}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SecretFieldViewModel">
                          <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="6" Margin="0,3">
                            <TextBlock Text="{Binding Label}" Classes="fieldLabel"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Display}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ToggleButton Grid.Column="2" Padding="10,4"
                                          Content="{Binding RevealButtonText}"
                                          IsChecked="{Binding IsRevealed}" />
                            <Button Grid.Column="3" Content="Copy" Padding="10,4"
                                    Click="OnCopySecretClicked" Tag="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Add / edit form: shown in place of the list while editing. Binds to
             the Editor sub view model on the CredentialViewModel. -->
        <ScrollViewer x:Name="CredentialsEditor"
                      IsVisible="{Binding IsEditing}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,14,20,20">
          <StackPanel MaxWidth="720" HorizontalAlignment="Stretch"
                      DataContext="{Binding Editor}" x:DataType="vm:CredentialEditorViewModel">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Title}" Classes="sectionHeading" />

                <StackPanel Spacing="4">
                  <TextBlock Text="Website or app name" Classes="fieldLabel" />
                  <TextBox Text="{Binding Site}" Watermark="e.g. bank.example.com" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Username" Classes="fieldLabel" />
                  <TextBox Text="{Binding Username}" Watermark="e.g. jane@example.com" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="Password" Classes="fieldLabel" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding Password}"
                             PasswordChar="&#x25CF;"
                             RevealPassword="{Binding IsPasswordVisible}"
                             FontFamily="Cascadia Mono, Consolas, monospace" />
                    <ToggleButton Grid.Column="1" Padding="12,4" Content="Show"
                                  IsChecked="{Binding IsPasswordVisible}" />
                  </Grid>
                </StackPanel>

                <!-- Extra fields -->
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Extra fields" Classes="fieldLabel" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Add field" Padding="12,4"
                            Command="{Binding AddExtraCommand}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Extras}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ExtraFieldEditorViewModel">
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6" Margin="0,3">
                          <TextBox Text="{Binding Key}" Watermark="Field name (e.g. PIN)" />
                          <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="Value" />
                          <Button Grid.Column="2" Content="Remove" Padding="12,4"
                                  Command="{Binding $parent[Window].DataContext.Credentials.Editor.RemoveExtraCommand}"
                                  CommandParameter="{Binding}" x:CompileBindings="False" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding Error}" Foreground="#D9534F"
                           TextWrapping="Wrap" IsVisible="{Binding HasError}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="SAVE"
                          Command="{Binding $parent[Window].DataContext.Credentials.SaveCommand}"
                          x:CompileBindings="False"
                          Classes="primary" Padding="24,8" FontWeight="SemiBold" />
                  <Button Content="CANCEL"
                          Command="{Binding $parent[Window].DataContext.Credentials.CancelEditCommand}"
                          x:CompileBindings="False"
                          Padding="24,8" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </DockPanel>
    </Panel>
    </Panel>
</Window>
