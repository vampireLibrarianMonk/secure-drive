<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EmergencyArchive.UI"
        x:Class="EmergencyArchive.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EMERGENCY ARCHIVE"
        Width="780" Height="560"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Password screen (spec section 7) -->
    <StackPanel IsVisible="{Binding !IsUnlocked}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Margin="40,0">
        <TextBlock Text="EMERGENCY ARCHIVE"
                   FontSize="28"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />

        <TextBlock Text="Password" FontSize="14" Margin="0,16,0,0" />

        <TextBox PasswordChar="&#x2022;"
                 Text="{Binding Password}"
                 Watermark="Archive password"
                 FontSize="16"
                 Width="420" />

        <Button Content="UNLOCK"
                Command="{Binding UnlockCommand}"
                HorizontalAlignment="Center"
                Padding="32,10"
                FontSize="16"
                Margin="0,10,0,0" />

        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Opacity="0.85"
                   Width="460"
                   Margin="0,14,0,0" />
    </StackPanel>

    <!-- Archive screen (read-only, spec sections 7/11/22) -->
    <Grid IsVisible="{Binding IsUnlocked}" Margin="16"
          RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="EMERGENCY ARCHIVE" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="READ ONLY" FontSize="13" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
            <Button Grid.Column="1" Content="LOCK" Command="{Binding LockCommand}" Padding="22,6" />
        </Grid>

        <TextBox Grid.Row="1"
                 Watermark="Filter documents by name"
                 Text="{Binding SearchText}"
                 Margin="0,10,0,0" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding FilteredDocuments}"
                 SelectedItem="{Binding SelectedDocument}"
                 Margin="0,10,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Margin="4,3" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="OPEN" Click="OnOpenClicked"
                    IsEnabled="{Binding HasSelectedDocument}" Padding="22,7" />
            <Button Content="EXPORT / COPY" Click="OnExportClicked"
                    IsEnabled="{Binding HasSelectedDocument}" Padding="22,7" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
