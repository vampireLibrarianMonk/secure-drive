<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EmergencyArchive.UI"
        x:Class="EmergencyArchive.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EMERGENCY ARCHIVE"
        Width="600" Height="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <!-- Emergency startup screen, spec section 7:
         one password field, one unlock button, nothing else. -->

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18"
                    Margin="40,0">
            <TextBlock Text="EMERGENCY ARCHIVE"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Password" FontSize="14" Margin="0,12,0,0" />

            <TextBox Name="PasswordBox"
                     PasswordChar="&#x2022;"
                     Text="{Binding Password}"
                     Watermark="Archive password"
                     FontSize="16" />

            <Button Content="UNLOCK"
                    Command="{Binding UnlockCommand}"
                    HorizontalAlignment="Center"
                    Padding="32,10"
                    FontSize="16"
                    Margin="0,8,0,0" />

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Opacity="0.8"
                       Margin="0,12,0,0" />
        </StackPanel>
    </Panel>

</Window>
